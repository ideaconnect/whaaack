<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Required so the Ads SDK can read the advertising id on API 33+. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <!-- android:appCategory="game" is load-bearing, not metadata. Android 16 ignores
         screenOrientation, resizeableActivity and aspect-ratio restrictions for apps
         targeting API 36 on displays with a smallest width of 600dp or more — every tablet,
         unfolded foldable and desktop-windowed session — and Android 17 removes even the
         temporary per-activity opt-out. Games are exempt from both, but only when they declare
         themselves one here. Without it the portrait lock below is silently dropped on exactly
         the devices whose layout has never been tested. -->
    <application
        android:name=".WhaaackApp"
        android:allowBackup="true"
        android:appCategory="game"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Whaaack">

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <!-- Play Games Services will not initialise without this, and the failure is a
             silent one: PlayGamesSdk.initialize() succeeds, the automatic sign-in never
             happens, and isAuthenticated() simply answers false for ever. The value must
             stay a @string reference — see the note beside it in strings.xml. -->
        <meta-data
            android:name="com.google.android.gms.games.APP_ID"
            android:value="@string/game_services_project_id" />

        <!-- Keeps the SDK's own initialisation and ad loading off the main thread, which is
             what these two flags actually control (they do not defer initialisation — that
             is AdsManager's job, and it only initialises once consent allows it).

             Both default to true as of Ads SDK 24.0.0 and play-services-ads-api declares
             them itself with the same value, so these are redundant. They are kept as an
             explicit statement of intent that survives a future change of default; because
             the values match the library's, the manifest merger has nothing to resolve. Do
             not set either to false without adding tools:replace. -->
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_INITIALIZATION"
            android:value="true" />
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_AD_LOADING"
            android:value="true" />

        <!-- screenOrientation="portrait" and resizeableActivity="false" are a product decision, not
             an accident: Whaaack! is played in portrait with two thumbs, and it is not offered in
             landscape. Google Play suggests removing both for large-screen support; that suggestion
             is declined deliberately, and it costs nothing in compliance — games are an explicit
             exception to Android 16's and Android 17's ignoring of these restrictions on displays
             600dp and wider, which is what android:appCategory="game" above buys.

             The renderer no longer depends on the lock, though. It sizes the board from whatever
             window it is handed — stacked HUD or one beside the board, and a compacted score card
             if that is what buys a playable board (see GameRenderer.layOut) — because free-form and
             desktop windowing do not always honour this, and a window that is merely unusual should
             get a playable board rather than a paused run. One too small for any arrangement still
             pauses the run rather than letting it be lost behind an undrawable board.

             windowSoftInputMode="adjustResize" is for the auth forms, and only matters below
             API 30. The activity is edge-to-edge, so from API 30 the IME never resizes the
             window and Modifier.imePadding() on those screens is what makes room for the
             keyboard. Older devices report no ime inset at all, so there imePadding() is zero
             and this is the mechanism instead: the window shrinks and the same scroll works.
             Nothing else in the app takes text input, and neither path double-counts. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|smallestScreenSize"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Whaaack"
            android:windowSoftInputMode="adjustResize"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Supabase bounces password-reset and email-confirmation links back here. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="whaaack" android:host="auth" />
            </intent-filter>
        </activity>
    </application>
</manifest>
